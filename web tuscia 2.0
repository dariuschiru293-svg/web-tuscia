    let currentLang = 'it';

    // -------------------------------------------------------------
    // GESTIONE CAMBIO LINGUA ISTANTANEO
    // -------------------------------------------------------------
    function setLanguage(lang) {
      if (!translations[lang]) return;
      currentLang = lang;
      document.documentElement.lang = lang;

      // Aggiorna bottoni stato
      document.getElementById('btn-lang-it').classList.toggle('active', lang === 'it');
      document.getElementById('btn-lang-en').classList.toggle('active', lang === 'en');
      document.getElementById('btn-lang-it-m').classList.toggle('active', lang === 'it');
      document.getElementById('btn-lang-en-m').classList.toggle('active', lang === 'en');

      document.getElementById('btn-lang-it').setAttribute('aria-pressed', lang === 'it');
      document.getElementById('btn-lang-en').setAttribute('aria-pressed', lang === 'en');

      // Aggiorna tutti gli elementi con data-i18n
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang][key]) {
          el.innerHTML = translations[lang][key];
        }
      });

      // Aggiorna Metadati e Title
      document.getElementById('meta-title').textContent = translations[lang].meta_title;
      document.getElementById('meta-desc').setAttribute('content', translations[lang].meta_desc);
      document.getElementById('og-title').setAttribute('content', translations[lang].meta_title);
      document.getElementById('og-desc').setAttribute('content', translations[lang].meta_desc);
    }

    // -------------------------------------------------------------
    // CONTROLLO MENU MOBILE
    // -------------------------------------------------------------
    const mobileToggle = document.getElementById('mobile-toggle');
    const mobileNav = document.getElementById('mobile-nav');

    mobileToggle.addEventListener('click', () => {
      const isOpen = mobileNav.classList.toggle('open');
      mobileToggle.setAttribute('aria-expanded', isOpen);
    });

    function closeMobileMenu() {
      mobileNav.classList.remove('open');
      mobileToggle.setAttribute('aria-expanded', 'false');
    }

    // -------------------------------------------------------------
    // GESTIONE FORM PREVENTIVO (VALIDAZIONE + MAILTO FALLBACK)
    // -------------------------------------------------------------
    function handleQuoteSubmit(e) {
      e.preventDefault();

      let hasError = false;

      // Reset errori
      document.querySelectorAll('.field-error').forEach(el => el.style.display = 'none');

      const name = document.getElementById('user-name').value.trim();
      const biz = document.getElementById('business-name').value.trim();
      const email = document.getElementById('user-email').value.trim();
      const phone = document.getElementById('user-phone').value.trim();
      const type = document.getElementById('project-type').value;
      const desc = document.getElementById('project-desc').value.trim();
      const privacy = document.getElementById('privacy-consent').checked;

      // Validazione formale accessibile
      if (!name) {
        document.getElementById('err-name').style.display = 'block';
        hasError = true;
      }
      if (!biz) {
        document.getElementById('err-biz').style.display = 'block';
        hasError = true;
      }
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        document.getElementById('err-email').style.display = 'block';
        hasError = true;
      }
      if (!desc) {
        document.getElementById('err-desc').style.display = 'block';
        hasError = true;
      }
      if (!privacy) {
        document.getElementById('err-privacy').style.display = 'block';
        hasError = true;
      }

      if (hasError) return;

      // Costruzione mailto trasparente senza finte API
      const recipient = "info@webtuscia.placeholder.it";
      const subject = encodeURIComponent(`Richiesta Preventivo Web Tuscia: ${biz} (${name})`);
      const body = encodeURIComponent(
        `Nome Cliente: ${name}\n` +
        `Attività: ${biz}\n` +
        `Email: ${email}\n` +
        `Telefono: ${phone || 'Non specificato'}\n` +
        `Tipologia Progetto: ${type}\n\n` +
        `Dettagli del Progetto:\n${desc}\n\n` +
        `---\nConsenso privacy espresso nel form frontend.`
      );

      const mailtoUrl = `mailto:${recipient}?subject=${subject}&body=${body}`;

      // Mostra alert trasparente con il link diretto
      const feedbackBox = document.getElementById('form-feedback');
      const fallbackLink = document.getElementById('mailto-fallback-link');
      fallbackLink.setAttribute('href', mailtoUrl);
      feedbackBox.style.display = 'block';

      // Prova ad aprire il client di posta dell'utente
      window.location.href = mailtoUrl;
    }

    // -------------------------------------------------------------
    // FUNZIONALITÀ INTERATTIVE DIMOSTRATIVE (OSTERIA TUSCIA)
    // -------------------------------------------------------------
    function triggerDemoWhatsApp() {
      const msg = currentLang === 'it' 
        ? "Buongiorno Osteria della Tuscia, vorrei richiedere informazioni per riservare un tavolo per 2 persone per questo fine settimana."
        : "Hello Osteria della Tuscia, I would like to inquire about reserving a table for 2 people this weekend.";
      
      // Utilizzo di numero dimostrativo esplicitamente non instradato
      alert(
        (currentLang === 'it' 
          ? "SIMULATORE WHATSAPP (DEMO):\n\nNella versione di produzione per un cliente reale, questo pulsante apre direttamente WhatsApp (wa.me/39XXXXXXXXXX) con il seguente messaggio preimpostato:\n\n\""
          : "WHATSAPP SIMULATOR (DEMO):\n\nIn a production environment for a real venue, this button opens WhatsApp directly with this pre-filled message:\n\n\"") +
        msg + "\""
      );
    }

    function simulateDemoNotice() {
      alert(
        currentLang === 'it'
          ? "PROGETTO DIMOSTRATIVO 'Osteria della Tuscia':\n\nQuesto esempio è stato sviluppato per mostrare come WEB TUSCIA struttura un sito per ristoratori locali:\n- Menu consultabile al volo senza scaricare PDF pesanti\n- Mappa e orari chiari per ridurre telefonate ripetitive\n- Call-to-Action rapida verso WhatsApp per raccogliere richieste di prenotazione."
          : "DEMONSTRATION SHOWCASE 'Osteria della Tuscia':\n\nThis demonstration illustrates how WEB TUSCIA crafts an effective website for local hospitality:\n- Lightweight digital menu requiring no heavy PDF downloads\n- Clear hours and location details reducing routine inquiries\n- Instant WhatsApp Call-to-Action to generate reservation inquiries."
      );
    }

    function alertPlaceholderContact() {
      alert(
        currentLang === 'it'
          ? "INFORMAZIONE DI TRASPARENZA:\nIl canale WhatsApp ufficiale di WEB TUSCIA verrà collegato al numero telefonico dedicato prima del lancio commerciale."
          : "TRANSPARENCY NOTE:\nThe official WEB TUSCIA WhatsApp link will be connected to its dedicated business number prior to commercial launch."
      );
    }

    // -------------------------------------------------------------
    // GESTIONE MODALI (PRIVACY & COOKIE)
    // -------------------------------------------------------------
    function openPrivacyModal() {
      document.getElementById('privacy-modal').classList.add('active');
    }
    function closePrivacyModal() {
      document.getElementById('privacy-modal').classList.remove('active');
    }
    function openCookieModal() {
      alert(
        currentLang === 'it'
          ? "COOKIE POLICY:\nQuesto sito statico non fa uso di cookie tecnici di profilazione, cookie pubblicitari o traccianti di terze parti. Non è richiesta l'accettazione di cookie banner invasivi."
          : "COOKIE POLICY:\nThis static website does not employ profiling, tracking, or third-party marketing cookies. No invasive consent banner is required."
      );
    }

    // Chiudi modale cliccando fuori
    window.addEventListener('click', (e) => {
      const modal = document.getElementById('privacy-modal');
      if (e.target === modal) {
        closePrivacyModal();
      }
    });

    // Anno corrente dinamico nel footer
    document.getElementById('current-year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
